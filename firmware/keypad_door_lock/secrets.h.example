#pragma once

// Copy this file to secrets.h and fill in your real values. secrets.h is
// gitignored -- never commit real WiFi/MQTT credentials.

const char WIFI_SSID[] = "your-wifi-name";
const char WIFI_PASSWORD[] = "your-wifi-password";

// Must be unique -- broker.hivemq.com is a shared PUBLIC broker, and every
// topic below is namespaced under this ID. Two devices with the same
// DEVICE_ID publishing to the same broker will see each other's events. See
// knowledge/07_wifi_mqtt_and_remote_unlock.md for why this matters and
// sim/doorlock_sim/mqtt_topics.py's new_device_id() for a generator. Example:
//   python -c "import secrets; print(secrets.token_hex(4))"
const char DEVICE_ID[] = "REPLACE_WITH_8_HEX_CHARS";
